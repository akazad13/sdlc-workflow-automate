{
  "base_branch": "main",
  "branch_prefix": "feature/",
  "commands": {
    "lint": null,
    "build": null,
    "test": null
  },
  "module_commands": {},
  "test_path_markers": ["test", "tests", "spec", "specs", "e2e", "__tests__"],
